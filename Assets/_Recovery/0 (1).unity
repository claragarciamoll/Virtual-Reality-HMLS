  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'Steady Hand Movement


    Rapid rotations or jerky scanner movements
    cause motion blur and feature tracking failure. This disrupts the SLAM algorithm,
    creating misaligned or corrupted 3D data. Please rotate the device smoothly and
    steadily to ensure continuous and accurate spatial mapping.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
