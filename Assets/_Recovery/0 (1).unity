      m_Calls: []
  m_text: 'Optimal Transition Speed


    Rapid movement through doorways causes
    a sudden shift in visual features. This abrupt change can overwhelm the SLAM
    algorithm, leading to map misalignment or tracking loss. Please proceed slowly
    and steadily through all room transitions to allow the scanner to properly connect
    both spaces.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
